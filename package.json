{
  "name": "suki-teeyai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:server:dev\" \"npm:client\"",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "lint": "eslint .",
    "reset-db": "node server/scripts/resetDb.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
